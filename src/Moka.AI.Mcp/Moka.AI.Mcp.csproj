<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Moka.AI.Mcp</PackageId>
    <Description>Model Context Protocol (MCP) client integration for Moka.AI — connect MCP servers and expose their tools to the AI chat pipeline.</Description>
    <PackageTags>ai;mcp;modelcontextprotocol;tools;llm;agents;function-calling</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CA1812;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moka.AI\Moka.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.nuget.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
