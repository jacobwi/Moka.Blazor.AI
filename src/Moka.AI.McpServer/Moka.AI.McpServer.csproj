<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Moka.AI.McpServer</PackageId>
    <Description>Host an MCP server from Moka.AI — expose the tools registered in AiChatOptions.Tools to external MCP clients (Claude Desktop, editors, other AI apps) over stdio or any official transport.</Description>
    <PackageTags>ai;mcp;modelcontextprotocol;tools;server;hosting;llm;agents</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CA1812;CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moka.AI\Moka.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.nuget.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
