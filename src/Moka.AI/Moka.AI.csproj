<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Moka.AI</PackageId>
    <Description>Provider-agnostic AI chat services with streaming, context builders, and pluggable providers. Works with LM Studio, Ollama, or any IChatClient provider. UI-free — usable from console, desktop, mobile, or web apps.</Description>
    <PackageTags>ai;chat;ollama;openai;llm;assistant;streaming</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CA1812;CA1822;CA1305;CA1031;CA1062;CA1002;CA1063;CA1816</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.nuget.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
